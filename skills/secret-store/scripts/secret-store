#!/usr/bin/env python3
"""Store a named secret in a private file without it appearing on screen, in chat or in a transcript.

  secret-store NAME            prompt for the secret without echo (or read it from a pipe), store it
  secret-store NAME --clipboard   take it from the clipboard instead (wl-paste, xclip or xsel)
  secret-store --path NAME     print the file a program should read the secret from
  secret-store --list          list the stored names, with each file's size and age
  secret-store --rm NAME       delete one

Files live in $SECRET_STORE_DIR, by default ~/.config/secret-store/ (mode 700), one file per secret
(mode 600), written atomically. NAME is letters, digits, dot, dash and underscore. The secret itself is
never printed: after storing, it prints the name, the length and the first 8 hex digits of its
SHA-256, so a person can check that the right value arrived. Python 3 standard library only.
"""
import getpass, hashlib, os, re, shutil, subprocess, sys, tempfile, time

DIR = os.path.expanduser(os.environ.get("SECRET_STORE_DIR") or "~/.config/secret-store")


def die(msg, code=2):
    print(f"secret-store: {msg}", file=sys.stderr)
    sys.exit(code)


def path(name):
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name) or name.startswith("."):
        die(f"bad name {name!r}: use letters, digits, dot, dash and underscore")
    return os.path.join(DIR, name)


def clipboard():
    for cmd in (["wl-paste", "--no-newline"], ["xclip", "-selection", "clipboard", "-o"],
                ["xsel", "--clipboard", "--output"]):
        if shutil.which(cmd[0]):
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode == 0:
                return r.stdout
    die("no clipboard tool found (wl-paste, xclip or xsel), or the clipboard is empty")


def store(name, clip):
    p = path(name)
    if clip:
        value = clipboard()
    elif sys.stdin.isatty():
        value = getpass.getpass(f"{name} (input hidden): ")
    else:
        value = sys.stdin.read()
    value = value.strip()
    if not value:
        die("empty secret, nothing stored")
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    os.chmod(DIR, 0o700)
    fd, tmp = tempfile.mkstemp(dir=DIR, prefix=".tmp-")
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, value.encode() + b"\n")
        os.close(fd)
        os.replace(tmp, p)
    except BaseException:
        os.unlink(tmp)
        raise
    print(f"stored {name}: {len(value)} characters, sha256 {hashlib.sha256(value.encode()).hexdigest()[:8]}, in {p}")


def main(a):
    if a[:1] == ["--path"] and len(a) == 2:
        print(path(a[1]))
    elif a == ["--list"]:
        if os.path.isdir(DIR):
            for n in sorted(os.listdir(DIR)):
                if not n.startswith("."):
                    st = os.stat(os.path.join(DIR, n))
                    print(f"{n}  {st.st_size} bytes  {int((time.time() - st.st_mtime) // 86400)} days old")
    elif a[:1] == ["--rm"] and len(a) == 2:
        try:
            os.unlink(path(a[1]))
        except FileNotFoundError:
            die(f"no secret named {a[1]}", 1)
        print(f"deleted {a[1]}")
    elif len(a) in (1, 2) and not a[0].startswith("-") and a[1:] in ([], ["--clipboard"]):
        store(a[0], a[1:] == ["--clipboard"])
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
