#!/usr/bin/env python3
"""Append one event to the swarm log.  ev AGENT KIND ID MESSAGE...   (ID is "-" when the event is about no finding)

Every agent reports through this; both dashboards and `devqueue` read the log. The dispatcher's `stage`,
`pass` and `note` events use the ID "-": the ID field is for finding ids only. One JSON object per line:
t (epoch seconds), agent, kind, id, msg (cut to 300 characters).
"""
import fcntl, json, os, sys, time

if len(sys.argv) < 4:
    sys.exit("usage: ev AGENT KIND ID MESSAGE...")
agent, kind, fid = sys.argv[1:4]
e = {"t": time.time(), "agent": agent, "kind": kind,
     "id": "" if fid == "-" else fid, "msg": " ".join(sys.argv[4:])[:300]}
with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "events.jsonl"), "a") as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.write(json.dumps(e) + "\n")
