#!/usr/bin/env bash
# tlock [--as NAME] COMMAND...: run a test command in one of the swarm's test slots.
#
# Waits for a free slot (the number is in slots/count, or SWARM_TEST_SLOTS), runs the command under a
# memory cap (SWARM_TEST_MEM, default 2G, through systemd-run; without systemd-run the command runs
# uncapped and a warning says so) and records the holder in slots/1.json, slots/2.json, ... for the
# dashboards. NAME (or $SWARM_AGENT) says who runs it, e.g. dev2, dev2-reviewer or final-reviewer.
# Every agent starts every test run through this, so at most that many runs share the machine.
# It logs each run as `test` events for the dashboards' activity view: "wait" when no slot is free,
# "start slot=N CMD", "end slot=N rc=RC took=Ss", or "gave up waiting" when it is stopped before a slot.
set -u
S=$(dirname "$(realpath "$0")")
MEM=${SWARM_TEST_MEM:-2G}
AS=${SWARM_AGENT:-}
if [ "${1:-}" = --as ]; then AS=${2:-}; shift 2 || shift; fi
ev() { "$S/ev" "${AS:-$(basename "$PWD")}" test - "$@" 2>/dev/null || true; }
trap 'exit 143' TERM INT HUP  # so the EXIT trap below still logs when the run is stopped
waiting=
run() {
	if command -v systemd-run >/dev/null; then
		systemd-run --user --scope -q -p MemoryMax="$MEM" "$@"
	else
		echo "tlock: systemd-run not found, running without a memory cap" >&2
		"$@"
	fi
}
while :; do
	N=${SWARM_TEST_SLOTS:-$(cat "$S/slots/count" 2>/dev/null || echo 1)}  # reread, so a changed count reaches waiting runs
	for i in $(seq 1 "$N"); do
		f="$S/test.lock"; [ "$i" -eq 1 ] || f="$S/test.lock.$i"
		exec {fd}>"$f"
		if flock -n "$fd"; then
			start=$(date +%s)
			trap 'rm -f "$S/slots/$i.json"; ev end slot=$i rc=143 took=$(( $(date +%s) - start ))s' EXIT
			ev start slot="$i" "$@"
			python3 -c 'import json, sys; print(json.dumps({"slot": int(sys.argv[1]), "pid": int(sys.argv[2]), '\
'"start": int(sys.argv[3]), "cwd": sys.argv[4], "agent": sys.argv[5], "cmd": " ".join(sys.argv[6:])}))' \
				"$i" $$ "$start" "$PWD" "$AS" "$@" > "$S/slots/$i.json"
			run "$@"; rc=$?
			trap - EXIT
			rm -f "$S/slots/$i.json"; ev end slot="$i" rc=$rc took=$(( $(date +%s) - start ))s; exit "$rc"
		fi
		exec {fd}>&-
	done
	if [ -z "$waiting" ]; then waiting=1; ev wait; trap 'ev gave up waiting' EXIT; fi
	sleep 3
done
