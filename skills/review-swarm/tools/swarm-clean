#!/usr/bin/env bash
# swarm-clean --swarm DIR [--repo DIR]: remove the swarm's worktrees and dev branches.
#
# Run after the swarm's work is merged. It removes SWARM/base, the per-pass trees SWARM/base-*, SWARM/merge and SWARM/dev* (refusing a worktree
# with uncommitted changes) and deletes each swarm-devN branch that is fully merged into
# swarm-review (also when the merge queue merged rebased copies of its commits), and the merge queue's
# refs/swarm/q/*. The swarm folder's log, findings and verdicts, and branch swarm-review, stay: delete
# them yourself once they are no longer needed.
set -euo pipefail
repo=. swarm=
while [ $# -gt 0 ]; do
	case "$1" in
		--repo) repo=$2; shift 2 ;;
		--swarm) swarm=$2; shift 2 ;;
		*) echo "unknown option $1" >&2; exit 2 ;;
	esac
done
[ -n "$swarm" ] || { echo "usage: swarm-clean --swarm DIR [--repo DIR]" >&2; exit 2; }
for t in "$swarm"/base "$swarm"/base-* "$swarm"/merge "$swarm"/dev*; do
	[ -d "$t" ] || continue
	if [ -n "$(git -C "$t" status --porcelain)" ]; then
		echo "$t has uncommitted changes; not removed" >&2; continue
	fi
	git -C "$repo" worktree remove "$t"
	echo "removed worktree $t"
done
git -C "$repo" worktree prune
for b in $(git -C "$repo" for-each-ref --format='%(refname:short)' 'refs/heads/swarm-dev*'); do
	if git -C "$repo" worktree list --porcelain | grep -qx "branch refs/heads/$b"; then
		echo "$b is still checked out in a kept worktree; kept" >&2
	elif git -C "$repo" branch -d "$b" >/dev/null 2>&1; then
		echo "deleted branch $b"
	elif ! git -C "$repo" cherry swarm-review "$b" | grep -q '^+'; then  # the merge queue merged rebased copies
		git -C "$repo" branch -qD "$b"; echo "deleted branch $b (its changes are on swarm-review as rebased commits)"
	else
		echo "$b has commits not in the checked-out branch; kept" >&2
	fi
done
git -C "$repo" for-each-ref --format='%(refname)' refs/swarm/ | while read -r r; do git -C "$repo" update-ref -d "$r"; done
echo "kept: branch swarm-review, and $swarm with its log, findings and verdicts"
